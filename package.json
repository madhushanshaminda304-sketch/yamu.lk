{
  "name": "yamo-lk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node --experimental-strip-types scripts/prerender.mjs",
    "preview": "npm run build && wrangler dev",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:browser": "playwright test",
    "check:i18n": "node scripts/audit-language.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:build": "npm run build && npx cap copy android",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sinhala": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.156.0"
  }
}
